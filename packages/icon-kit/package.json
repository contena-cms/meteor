{
  "name": "@contena-ag/meteor-icon-kit",
  "version": "5.11.0",
  "description": "An icon library and toolkit that follows a minimal, yet highly expressive style perfectly aligned with Contena's product language",
  "keywords": [
    "svg",
    "contena",
    "icons"
  ],
  "homepage": "https://github.com/contena-cms/meteor/tree/main/packages/icon-kit#readme",
  "bugs": {
    "url": "https://github.com/contena-cms/meteor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contena-cms/meteor.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Contena",
  "main": "index.js",
  "files": [
    "icons"
  ],
  "scripts": {
    "docs:copy": "../developer-portal/docs-cli link --src docs --dst resources/meteor-icon-kit",
    "docs:link": "../developer-portal/docs-cli link --src docs --dst resources/meteor-icon-kit --symlink",
    "docs:preview": "../developer-portal/docs-cli preview",
    "lint:all": "npm run lint:types && npm run lint:eslint",
    "lint:eslint": "eslint ./src",
    "lint:types": "tsc --noEmit",
    "changeset": "tsx ./src/changeset/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest"
  },
  "prettier": "@contena-ag/meteor-prettier-config",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@contena-ag/meteor-prettier-config": "workspace:*",
    "@types/node": "^20.14.9",
    "@types/svgo": "^2.6.3",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "svg-pathdata": "^6.0.3",
    "svgo": "^2.8.0",
    "ts-node": "^10.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "winston": "^3.17.0"
  }
}
